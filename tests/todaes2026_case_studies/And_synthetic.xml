    <configuration type="run" path="todaes2026/And/run_miner.sh"/>
    <input_adaptor path="vcd_to_vcd/run.sh"/>
    <output_adaptor path="spotltl_to_spotltl/run.sh"/>
    <export MAX_THREADS="1" CLK="clk" SCOPE="And_top_bench::And_top_" CONFIG="todaes2026/And/config.xml"/>
    <docker image="samger/harm:latest"/>  
  </usecase>

  <usecase id="texada">
